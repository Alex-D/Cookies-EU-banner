---
import Button from "./Button.astro";
---

<template id="cookies-eu-banner-template">
	<div class="cookies-eu-banner__wrapper">
		<div class="cookies-eu-banner">
			<div class="cookies-eu-banner__text">
				<div class="cookies-eu-banner__title">
					Banner demo
				</div>
				<p class="cookies-eu-banner__message">
					This banner is for demo purpose only, and do not trigger anything.
				</p>
			</div>
			<Button secondary={true} id="cookies-eu-reject">Reject</Button>
			<Button id="cookies-eu-accept">Accept</Button>
		</div>
	</div>
</template>

<style lang="scss" is:global>
	@use "../assets/styles/base/variables.scss";

	.cookies-eu-banner__wrapper {
		--banner-translate-y: 0;

		position: fixed;
		inset: 0;
		top: unset;
		padding: 20rem 2.4rem 2.4rem;
		pointer-events: none;
		z-index: 10;

		&::before {
			content: "";
			position: absolute;
			inset: 0;
			background: radial-gradient(
				100% 100% at bottom,
				var(--color-gradient-from) 20%,
				transparent
			);
			transform: translateY(var(--banner-translate-y));
			transition: transform 300ms;
			animation: bannerShadowIn 150ms;
		}
	}

	@keyframes bannerShadowIn {
		from {
			transform: translateY(100%);
		}
	}

	.cookies-eu-banner {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.6rem;
		max-width: 80rem;
		margin: 0 auto;
		background: light-dark(var(--color-primary-50), var(--color-primary-900));
		color: light-dark(var(--color-primary-800), var(--color-primary-100));
		border: 0.2rem solid light-dark(var(--color-primary-700), var(--color-primary-300));
		border-bottom-width: 0.6rem;
		padding: 1.6rem;
		pointer-events: initial;
		@include variables.squircle(variables.$border-radius-l);
		transform: translateY(var(--banner-translate-y));
		will-change: transform;
		transition: transform 200ms;
		animation: bannerIn 200ms cubic-bezier(0.34, 1.56, 0.64, 1);

		&--before-remove {
			--banner-translate-y: 200%;
		}

		@media (max-width: #{variables.$breakpoint-desktop - 1}) {
			:first-child {
				grid-column: span 2;
			}
		}

		@media (min-width: variables.$breakpoint-desktop) {
			grid-template-columns: 1fr auto auto;
			padding-inline-end: 2.4rem;
		}
	}

	@keyframes bannerIn {
		from {
			transform: translateY(100%) scale(0.9, 0.5);
		}
	}

	.cookies-eu-banner__text {
		padding: 0.8rem;

		p {
			padding: 0;
			line-height: 1.3;
		}
	}

	.cookies-eu-banner__title {
		font-size: 2rem;
		font-family: var(--font-family-title);
		color: light-dark(var(--color-primary-700), var(--color-primary-300));
		padding-block: 0.4rem 0.2rem;
		text-box: trim-start cap alphabetic;
	}

	.cookies-eu-banner .c-button {
		margin-block: auto;
	}
</style>
