---
import Button from "./Button.astro";
---

<template id="cookies-eu-banner-template">
	<div class="cookies-eu-banner__wrapper">
		<div class="cookies-eu-banner">
			<div class="cookies-eu-banner__text">
				<div class="cookies-eu-banner__title">
					Banner demo
				</div>
				<p class="cookies-eu-banner__message">
					This banner is for demo purpose only, and do not trigger anything.
				</p>
			</div>
			<Button secondary={true} id="cookies-eu-reject">Reject</Button>
			<Button id="cookies-eu-accept">Accept</Button>
		</div>
	</div>
</template>

<style lang="scss">
	@use "../assets/styles/components/banner";
</style>
