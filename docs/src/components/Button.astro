---
type Props = {
	secondary?: boolean;
	class?: string;
} & Omit<HTMLAttributes<"button">, "class">

const {
	secondary,
	class: classNames,
	...htmlAttributes
} = Astro.props;

const classList: Record<string, boolean> = {
	"c-button--secondary": secondary,
};
classNames?.split(" ").forEach((className) => {
	classList[className] = true
});
---

<button
	class="c-button"
	class:list={classList}
	{...htmlAttributes}
>
	<slot/>
</button>

<style lang="scss" is:global>
	@use "../assets/styles/components/button";
</style>
