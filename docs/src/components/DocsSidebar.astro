---
import { getDocs } from "../collectionLoaders.ts";
import type { SidebarLinksByCategory } from "../types/sidebarLinksByCategory.ts";
import Sidebar from "./Sidebar.astro";

const docs = await getDocs();

const guides = docs.filter((doc) => doc.id.includes("guide"));
const integrations = docs.filter((doc) => doc.id.includes("integration"));
const reference = docs.filter((doc) => doc.id.includes("reference"));
const rootDocs = docs.filter((doc) => !guides.includes(doc) && !integrations.includes(doc) && !reference.includes(doc));

const baseUrl = import.meta.env.BASE_URL;
function docToLink(doc) {
	return {
		title: doc.data.title,
		href: baseUrl + "documentation" + doc.id.replace(/docs\/\w+\//, '/').replace('docs', '') + '/',
	};
}

const linksByCategory: SidebarLinksByCategory = [
	{
		links: rootDocs.map((doc) => docToLink(doc)),
	},
	{
		title: "Guides",
		links: guides.map((doc) => docToLink(doc)),
	},
	{
		title: "Integrations",
		links: integrations.map((doc) => docToLink(doc)),
	},
	{
		title: "Reference",
		links: reference.map((doc) => docToLink(doc)),
	},
];
---

<Sidebar linksByCategory={linksByCategory} />
