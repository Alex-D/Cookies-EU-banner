---
import { type CollectionEntry, render } from "astro:content";

import type { Collection } from "../content.config.ts";
import Layout from "./Layout.astro";
import DocsSidebar from "../components/DocsSidebar.astro";

type Props = {
	doc: CollectionEntry<Collection.DOCS>
}

const {
	doc
} = Astro.props;

const {
	title,
} = doc.data;
const {Content} = await render(doc);
---

<Layout
	title={`${title} — Cookies EU banner`}
>
	<div class="l-with-sidebar">
		<DocsSidebar />
		<div class="l-with-sidebar__content">
			<section class="m-section">
				<Content/>
				<slot />
			</section>
		</div>
	</div>
</Layout>

<style lang="scss" is:global>
	@use "../assets/styles/layouts/with-sidebar";
</style>
