---
import { Font } from "astro:assets";

import Footer from "../components/Footer.astro";
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import IconSpritesheet from "../components/IconSpritesheet.astro";
import '../assets/styles/index.scss';

export interface Props {
	title: string;
}

const {title} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<Head
	title={title}
	description="Cookies EU banner is a JavaScript library to manage the display of a banner to accept/reject cookies from tracking services like Google Analytics."
>
	<Font cssVariable="--font-uni-neue" preload />
	<Font cssVariable="--font-jetbrains-mono" preload />
	<Font cssVariable="--font-nexa-text" preload />
</Head>
<body>
<script>
	document.body.classList.add('js');

	// Safari polyfill
	window.requestIdleCallback ??= (callback) => {
		return window.setTimeout(() => callback({
			didTimeout: false,
			timeRemaining: () => 0,
		}), 0);
	}
</script>
<IconSpritesheet>
	<div class="m-header-and-main">
		<Header/>
		<main>
			<slot/>
		</main>
	</div>
	<Footer/>
</IconSpritesheet>
{import.meta.env.DEV && <style>
	@media (max-width: 700px) {
		astro-dev-toolbar {
			display: none;
		}
	}
</style>}
</body>
</html>
