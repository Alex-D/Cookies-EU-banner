---
import Layout from "../layouts/Layout.astro";
import BannerTemplate from "../components/BannerTemplate.astro";
import Button from "../components/Button.astro";
---

<Layout title="Demo — Cookies EU banner, A 1kb vanilla JS script to manage consent cookie banner">
	<section class="m-section m-section--demo">
		<h2 class="m-section__title">Demo</h2>

		<p>
			You should see the banner at the bottom of your screen, and can use the reset button below anytime.
		</p>

		<div class="demo__blocks">
			<div class="demo__state">
				<h3 class="m-section__subtitle">State</h3>

				<dl>
					<dt>Cookie value</dt>
					<dd id="cookie-value">&nbsp;</dd>

					<dt>Consent state</dt>
					<dd id="cookies-eu-state">&nbsp;</dd>

					<dt>DoNotTrack</dt>
					<dd id="dnt-state">&nbsp;</dd>
				</dl>
			</div>

			<div class="demo__custom-controls">
				<h3 class="m-section__subtitle">Custom controls</h3>

				<div class="demo__buttons">
					<Button secondary={true} id="custom-accept">Accept</Button>
					<Button secondary={true} id="custom-reject">Reject</Button>
					<Button secondary={true} id="custom-reset">Reset the demo</Button>
				</div>
			</div>
		</div>
	</section>

	<BannerTemplate />
</Layout>

<style lang="scss" is:global>
	@use "../assets/styles/base/variables.scss";

	.demo__blocks {
		margin-top: 2.4rem;

		@media (min-width: #{variables.$breakpoint-desktop}) {
			display: grid;
			grid-template-columns: 1fr 1fr;
		}
	}

	.demo__state {
		dl {
			padding-block: 1.6rem 2.4rem;
		}

		dt {
			margin-bottom: -0.25em;
		}

		dd {
			font-family: var(--font-family-title);
			font-weight: bold;
			margin-bottom: 1.2rem;
		}

		@media (min-width: #{variables.$breakpoint-large-mobile}) {
			dl {
				display: flex;
				flex-flow: column wrap;
				box-sizing: content-box;
				max-height: 4em;
			}

			dd {
				min-height: 2em;
				margin-bottom: unset;
			}
		}
	}

	.demo__buttons {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.8rem;
		margin-top: 1.6rem;
	}

	#custom-reset {
		grid-column: span 2;
	}
</style>

<script>
	import { createCookiesBanner } from "cookies-eu-banner";

	document.querySelector<HTMLSpanElement>("#dnt-state")!.innerText = navigator.doNotTrack === "1" ? "Enabled" : "Disabled";

	const consentCookieName = "demoConsent";
	const cookiesBanner = createCookiesBanner({
		consentCookieName,
		onAccept: () => {
			console.log("Run analytics script!");

			updateCookiesEuState();
		},
		onReject: () => {
			updateCookiesEuState();
		},

		// Manage the transition before removing the banner
		delayBeforeRemove: 500,
	});

	function updateCookiesEuState() {
		setTimeout(() => {
			// Cookie value
			const cookieValue = cookiesBanner.getCookie(consentCookieName);
			document.querySelector<HTMLSpanElement>("#cookie-value")!.innerText = cookieValue ? `"${cookieValue}"` : "undefined";

			// Has consent
			const hasConsent = cookiesBanner.hasConsent();

			let state = "No choice";
			if (hasConsent === true) {
				state = "Accepted";
			} else if (hasConsent === false) {
				state = "Rejected";
			}

			document.querySelector<HTMLSpanElement>("#cookies-eu-state")!.innerText = state;
		}, 0);
	}

	updateCookiesEuState();

	document.querySelector("#custom-accept")!.addEventListener("click", () => {
		cookiesBanner.setConsent(true);
	});
	document.querySelector("#custom-reject")!.addEventListener("click", () => {
		cookiesBanner.setConsent(false);
	});

	document.querySelector("#custom-reset")!.addEventListener("click", async () => {
		cookiesBanner.deleteCookie(consentCookieName);
		await cookiesBanner.removeBanner(0);
		cookiesBanner.showBanner();
		updateCookiesEuState();
	});
</script>
