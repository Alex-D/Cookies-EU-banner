---
import DemoLayout from "../../layouts/DemoLayout.astro";
import BannerTemplate from "../../components/BannerTemplate.astro";
import Button from "../../components/Button.astro";
import Code from "../../components/Code.astro";
import DemoNav from "../../components/DemoNav.astro";

const demoCode = `
import { createCookiesBanner } from "cookies-eu-banner";

const consentCookieName = "demoConsent";
const cookiesBanner = createCookiesBanner({
	consentCookieName,
	onAccept: () => {
		console.log("Run analytics script!");
	},

	// Manage the transition duration before removing the banner
	delayBeforeRemove: 500,
});
`;

const customControlsCode = `
document.querySelector("#custom-accept").addEventListener("click", () => {
	cookiesBanner.setConsent(true);
});
document.querySelector("#custom-reject").addEventListener("click", () => {
	cookiesBanner.setConsent(false);
});
document.querySelector("#custom-reset").addEventListener("click", async () => {
	cookiesBanner.deleteCookie(consentCookieName);
	await cookiesBanner.removeBanner(0);
	cookiesBanner.showBanner();
});
`;
---

<DemoLayout title="Demo">
	<section class="m-section">
		<h2 class="m-section__title">Demo</h2>

		<p>
			You should see the banner at the bottom of your screen, and can use the reset button below anytime.
		</p>

		<div class="demo__blocks">
			<div class="demo__state">
				<h3 class="m-section__subtitle">State</h3>

				<dl>
					<dt>Cookie value</dt>
					<dd id="cookie-value">&nbsp;</dd>

					<dt>Consent state</dt>
					<dd id="cookies-eu-consent-state">&nbsp;</dd>
				</dl>
			</div>

			<div class="demo__custom-controls">
				<h3 class="m-section__subtitle">Custom controls</h3>

				<div class="demo__buttons">
					<Button secondary={true} id="custom-accept">Accept</Button>
					<Button secondary={true} id="custom-reject">Reject</Button>
					<Button secondary={true} id="custom-reset">Reset the demo</Button>
				</div>
			</div>
		</div>
	</section>
	<section class="m-section">
		<h2 class="m-section__title">The code</h2>

		<Code code={demoCode}/>

		<h3>Custom controls</h3>

		<p>
			If you want to control the banner from outside the template, you can.
		</p>

		<Code code={customControlsCode} />
	</section>

	<BannerTemplate />
</DemoLayout>

<style lang="scss" is:global>
	@use "../../assets/styles/pages/demo";
</style>

<script>
	import { createCookiesBanner } from "cookies-eu-banner";

	const consentCookieName = "demoConsent";
	const cookiesBanner = createCookiesBanner({
		consentCookieName,
		onAccept: () => {
			console.log("Run analytics script!");
		},

		// Manage the transition before removing the banner
		delayBeforeRemove: 500,
	});

	function onStateUpdate() {
		const state = cookiesBanner.getState();

		// Cookie value
		const cookieValue = cookiesBanner.getCookie(consentCookieName);
		document.querySelector<HTMLSpanElement>("#cookie-value")!.innerText = cookieValue ? `"${cookieValue}"` : "undefined";

		// Has consent
		const hasConsent = state.hasConsent;

		let consentState = "No choice";
		if (hasConsent === true) {
			consentState = "Accepted";
		} else if (hasConsent === false) {
			consentState = "Rejected";
		}

		document.querySelector<HTMLSpanElement>("#cookies-eu-consent-state")!.innerText = consentState;
	}

	cookiesBanner.subscribe(() => {
		onStateUpdate();
	});

	onStateUpdate();

	document.querySelector("#custom-accept")!.addEventListener("click", () => {
		cookiesBanner.setConsent(true);
	});
	document.querySelector("#custom-reject")!.addEventListener("click", () => {
		cookiesBanner.setConsent(false);
	});

	document.querySelector("#custom-reset")!.addEventListener("click", async () => {
		cookiesBanner.resetConsent();
		await cookiesBanner.removeBanner(0);
		cookiesBanner.showBanner();
	});
</script>
