---
import { Image } from "astro:assets";

import Layout from '../layouts/Layout.astro';
import Icon from "../components/Icon.astro";
import VerticalCard from "../components/VerticalCard.astro";

import mascot from "../assets/images/cookies-eu-banner-mascot.png";
import CardLink from "../components/CardLink.astro";
---

<Layout
	title="Cookies EU Banner, A 1kb vanilla JS script to manage consent cookie banner"
	showHeaderMascot={false}
>
	<section class="m-hero">
		<Image
			src={mascot}
			alt=""
			width="200"
			densities={[1, 2]}
			class="m-hero-title-mascot"
			aria-hidden="true"
			loading="eager"
			fetchpriority="high"
		/>
		<h1 class="m-hero-title">Cookies EU Banner</h1>
		<h2 class="m-hero-tagline">
			A 1kb vanilla JavaScript library managing cookies consent banner.
		</h2>

		<div class="m-hero__links">
			<CardLink
				href="./documentation/get-started/"
				icon="ui/documentation"
			>
				Get started
			</CardLink>
			<CardLink
				href="./demo/"
				icon="ui/demo"
			>
				Try it live
			</CardLink>
		</div>
	</section>

	<section class="m-section home-vertical-cards">
		<VerticalCard
			icon="ui/compliant"
			title="GDPR compliant"
		>
			This library matches requirements of European Commission and CNIL.
		</VerticalCard>

		<VerticalCard
			icon="ui/optimization"
			title="Lightweight & Simple"
		>
			Just 1kb of vanilla JavaScript.
			You can apply any style you want on this banner.
		</VerticalCard>

		<VerticalCard
			icon="ui/stars-ai"
			title="Optimized for SEO & AI"
		>
			The banner is only shown to human users:
			it will not appear in the description of any of your pages.
		</VerticalCard>

		<VerticalCard
			icon="ui/code"
			title="Fully typed"
		>
			The library is shipped with types included. <br>
			Written in TypeScript.
		</VerticalCard>

		<VerticalCard
			icon="ui/software"
			title="Headless alternative"
		>
			Go beyond the default UI implementation using direct access to the core logic.
			See <a href="./documentation/headless/">Headless documentation</a>.
		</VerticalCard>
	</section>

	<section id="donate" class="m-donate">
		<h3 class="m-donate__title">Support the project</h3>
		<p>
			Cookies EU banner is an MIT-licensed open source project and completely free to use.
			You can thank me or support it's ongoing development by making a donation.
		</p>
		<div class="m-donate__links">
			<CardLink
				href="https://www.patreon.com/alexandredemode"
				icon="socials/patreon"
				secondary
			>
				Be a sponsor on Patreon
			</CardLink>
			<CardLink
				href="https://www.paypal.me/demodealexandre/20eur"
				icon="socials/paypal"
				secondary
			>
				Donate via PayPal
			</CardLink>
		</div>
	</section>
</Layout>

<style lang="scss" is:global>
	@use "../assets/styles/base/variables.scss";

	.m-hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		max-width: 60rem;
		margin: 6.4rem auto 3.2rem;
	}

	.m-hero-title-mascot {
		margin-bottom: -1.8rem;
	}

	.m-hero-title {
		font-size: 1.8rem;

		@media (min-width: variables.$breakpoint-desktop) {
 			font-size: 2.4rem;
		}
	}

	.m-hero-tagline {
		font-size: 2.4rem;
		color: light-dark(var(--color-primary-800), var(--color-primary-200));
		margin-top: 0.5em !important;

		@media (min-width: variables.$breakpoint-desktop) {
			font-size: 3.2rem;
		}
	}

	.m-hero__links {
		display: flex;
		flex-direction: column;
		gap: 1.6rem;
		margin-block: 3.2rem;

		@media (min-width: #{variables.$breakpoint-desktop}) {
			flex-direction: row;
			gap: 3.2rem;
		}
	}

	.home-vertical-cards {
		display: grid;
		gap: 3.2rem;
		background: none !important;
		padding-inline: 0;
		padding-bottom: 0;

		@media (min-width: variables.$breakpoint-desktop) {
			grid-template-columns: repeat(6, 1fr);
			.c-vertical-card {
				grid-column: span 2;

				&:nth-child(4),
				&:nth-child(5) {
					grid-column: span 3;
				}
			}
		}
	}

	.m-donate {
		max-width: min(60rem, variables.maxWidth());
		margin-top: 12.8rem;
		margin-inline: auto;
		padding: 3.2rem 1.6rem;
		background-color: light-dark(var(--color-primary-50), var(--color-primary-950));
		@include variables.squircle(variables.$border-radius-l);
		overflow: hidden;

		@media (min-width: variables.$breakpoint-desktop) {
			margin-bottom: 6.4rem;
			padding-inline: 3.2rem;
			@include variables.squircle(variables.$border-radius-xl);
		}

		&__title {
			font-size: 3.2rem;
		}

		&__links {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
			gap: 2.4rem;
			margin-top: 2.4rem;
		}
	}

	.home-vertical-cards,
	.m-donate {
		@media (max-width: variables.$breakpoint-desktop - 1) {
			--_body-gutters-base: 32px;
			--body-gutters: calc(var(--_body-gutters-base) + var(--body-border-width) * 2);
		}
	}
</style>
