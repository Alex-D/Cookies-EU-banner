{
  "name": "cookies-eu-banner",
  "version": "3.0.0",
  "description": "Manage display of banner to accept/reject cookies from tracking services like Google Analytics",
  "keywords": [
    "analytics",
    "cookies",
    "gdpr",
    "rgpd"
  ],
  "homepage": "https://alex-d.github.io/Cookies-EU-banner/",
  "bugs": {
    "url": "https://github.com/Alex-D/cookies-eu-banner/issues"
  },
  "license": "MIT",
  "author": "Alex-D <contact@alex-d.fr> (https://alex-d.fr)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alex-D/cookies-eu-banner.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "unpkg": "./dist/cookies-eu-banner.global.js",
  "jsdelivr": "./dist/cookies-eu-banner.global.js",
  "exports": {
    ".": {
      "import": "./dist/cookies-eu-banner.js",
      "types": "./dist/cookies-eu-banner.d.ts"
    },
    "./headless": {
      "import": "./dist/cookies-eu-banner.headless.js",
      "types": "./dist/cookies-eu-banner.headless.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "dev:all": "pnpm -r --include-workspace-root --parallel dev",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "bumpp": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  }
}
